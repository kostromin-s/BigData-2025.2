FROM apache/spark-py:latest

USER root

# Install required Python packages
RUN python3 -m pip install --no-cache-dir \
    pyspark==3.5.0 \
    streamlit==1.29.0 \
    plotly==5.18.0 \
    pandas==2.1.4 \
    matplotlib==3.8.2 \
    seaborn==0.13.0

WORKDIR /app

# Expose Streamlit port
EXPOSE 8501

# Run Streamlit
CMD ["streamlit", "run", "dashboard.py", "--server.port=8501", "--server.address=0.0.0.0"]
